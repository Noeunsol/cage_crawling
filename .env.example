# API 키 템플릿. 복사해서 .env로 만들고 값을 채우세요:
#   cp .env.example .env
# 앱과 CLI가 프로젝트 루트의 .env를 자동으로 로드합니다.
# .env는 gitignore됨 — 절대 커밋 금지.

# ── 지금 필요 (keyword 검색, real) ──
SERPAPI_KEY=

# ── 선택: matching.llm.enabled=true 일 때 (Claude Haiku 분류) ──
# OpenAI taxonomy classifier (matching.llm.provider=openai)
OPENAI_API_KEY=

# Anthropic classifier를 선택한 경우
# anthropic.Anthropic()가 자동으로 읽음
ANTHROPIC_API_KEY=

# ── 선택: extraction.firecrawl.enabled=true 일 때 (최후 수단 추출) ──
# FirecrawlApp()가 자동으로 읽음
FIRECRAWL_API_KEY=

# ── 미채택(mock/seam) — 실제 연동 시 추가 ──
# TAVILY_API_KEY=
# EXA_API_KEY=
